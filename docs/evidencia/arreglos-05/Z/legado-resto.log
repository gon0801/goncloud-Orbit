            harvest_destino._SQL_GRUPO: [(1, "category_phrase", "200", "201")],
            harvest_destino._SQL_EXCEPCION: [],
            harvest_destino._SQL_GOALS: [goal],
        }
    
        class Memoria:
            def transaction(self):
                return nullcontext()
    
            def execute(self, sql, params=()):
                valores = filas[sql]
    
                class Filas:
