+def resumen_campanas(conn, platform, desde, hasta):
+    rows = conn.execute(
+        """
+        SELECT campaign_id,
+               currency,
+               SUM(cost) AS cost,
+               COALESCE(SUM(ad_revenue), 0) AS revenue
+          FROM ad_metric
+         WHERE platform = %s
+           AND metric_date BETWEEN %s AND %s
+         GROUP BY campaign_id, currency
+         ORDER BY cost DESC
+        """,
+        (platform, desde, hasta),
+    ).fetchall()
+    return [
+        {
+            "campaign_id": row[0],
+            "currency": row[1],
+            "cost": float(row[2]),
+            "revenue": float(row[3]),
+        }
+        for row in rows
+    ]
