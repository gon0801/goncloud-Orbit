def _http(url: str, timeout: float = 5.0) -> tuple[int, dict[str, str], bytes]:
    req = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            headers = {k.lower(): v for k, v in resp.headers.items()}
            return resp.status, headers, resp.read()
    except urllib.error.HTTPError as exc:
        headers = {k.lower(): v for k, v in exc.headers.items()} if exc.headers else {}
        return exc.code, headers, exc.read()


def _navegador() -> str:
    """Chrome del PATH, o Edge en la Mac si Chrome no esta instalado."""
    elegido = os.environ.get("ORBIT_VERIFY_CHROME", "").strip()
    if elegido:
        return elegido
    candidatos = (
        "google-chrome",
        "google-chrome-stable",
        "chromium",
        "chromium-browser",
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge",
    )
    for candidato in candidatos:
        if candidato.startswith("/") or os.path.sep in candidato:
            if os.path.isfile(candidato):
                return candidato
        encontrado = shutil.which(candidato)
        if encontrado:
            return encontrado
    return "google-chrome"


def _ws_enviar(sock: socket.socket, texto: str) -> None:
    datos = texto.encode()
    mascara = os.urandom(4)
    n = len(datos)
    cabecera = bytearray([0x81])
    if n < 126:
        cabecera.append(0x80 | n)
    elif n < 65536:
        cabecera.append(0x80 | 126)
        cabecera += struct.pack("!H", n)
    else:
        cabecera.append(0x80 | 127)
        cabecera += struct.pack("!Q", n)
    cabecera += mascara
    sock.sendall(bytes(cabecera) + bytes(b ^ mascara[i % 4] for i, b in enumerate(datos)))


def _ws_recv(sock: socket.socket) -> bytes:
    """Un `recv` que corta en EOF en vez de girar para siempre."""
    datos = sock.recv(4096)
    if not datos:
        raise EOFError("websocket cerrado por el navegador")
    return datos


def _ws_leer(sock: socket.socket, pendiente: bytes) -> tuple[int, bytes, bytes]:
    buf = pendiente
    while len(buf) < 2:
        buf += _ws_recv(sock)
    largo = buf[1] & 0x7F
    i = 2
    if largo == 126:
        while len(buf) < 4:
            buf += _ws_recv(sock)
        largo = struct.unpack("!H", buf[2:4])[0]
        i = 4
    elif largo == 127:
        while len(buf) < 10:
            buf += _ws_recv(sock)
        largo = struct.unpack("!Q", buf[2:10])[0]
        i = 10
    if buf[1] & 0x80:
        i += 4
    while len(buf) < i + largo:
        buf += _ws_recv(sock)
    return buf[0] & 0x0F, buf[i : i + largo], buf[i + largo :]


def _foco_y_ancho(url: str, png: Path, detalle: Path) -> dict:
    """Foco de teclado en la tabla y desborde real a 390 px, via el navegador."""
    proc = None
    perfil = None
    try:
        navegador = _navegador()
        perfil = Path("/tmp") / f"orbit-foco-{os.getpid()}"
        shutil.rmtree(perfil, ignore_errors=True)
        perfil.mkdir(parents=True, exist_ok=True)
        proc = subprocess.Popen(
            [
                navegador,
                "--headless=new",
                "--disable-gpu",
                "--no-sandbox",
                "--disable-dev-shm-usage",
                "--remote-debugging-port=0",
                f"--user-data-dir={perfil}",
                "--window-size=1280,900",
                "about:blank",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        marca = perfil / "DevToolsActivePort"
        fin = time.time() + 15
        while not marca.is_file():
            if proc.poll() is not None or time.time() > fin:
                if proc.poll() is None:
                    proc.terminate()
                    try:
                        proc.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        proc.kill()
                        proc.wait()
                try:
                    _, err = proc.communicate(timeout=2)
                except subprocess.TimeoutExpired:
                    err = "(stderr no cerro a tiempo)"
                detalle.write_text(f"devtools no arranco: {err or ''}\n", encoding="utf-8")
                return {}
            time.sleep(0.1)
        puerto = int(marca.read_text(encoding="utf-8").splitlines()[0])
        with urllib.request.urlopen(f"http://127.0.0.1:{puerto}/json/list", timeout=5) as resp:
            paginas = json.loads(resp.read().decode())
        pagina = next(p for p in paginas if p.get("type") == "page")
        ws = urllib.parse.urlparse(pagina["webSocketDebuggerUrl"])
        sock = socket.create_connection((ws.hostname, ws.port), timeout=10)
        llave = base64.b64encode(os.urandom(16)).decode()
        sock.sendall(
            (
                f"GET {ws.path} HTTP/1.1\r\n"
                f"Host: {ws.hostname}:{ws.port}\r\n"
                "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                f"Sec-WebSocket-Key: {llave}\r\nSec-WebSocket-Version: 13\r\n\r\n"
            ).encode()
        )
        saludo = b""
        while b"\r\n\r\n" not in saludo:
            saludo += _ws_recv(sock)
        pendiente = saludo.split(b"\r\n\r\n", 1)[1]
        ident = 0

        def llamar(metodo: str, params: dict | None = None) -> dict:
            nonlocal ident, pendiente
            ident += 1
            mensaje = {"id": ident, "method": metodo}
            if params:
                mensaje["params"] = params
            _ws_enviar(sock, json.dumps(mensaje))
            while True:
                opcode, payload, pendiente = _ws_leer(sock, pendiente)
                if opcode == 8:
                    raise EOFError("websocket cerrado por el navegador")
                if opcode != 1:
                    continue
                data = json.loads(payload.decode())
                if data.get("id") == ident:
                    return data

        llamar("Page.enable")
        llamar("Runtime.enable")
        llamar("Page.navigate", {"url": url})
        time.sleep(1.2)
        llamar(
            "Runtime.evaluate",
            {
                "expression": """(() => {
                  document.querySelectorAll('details.detail-box').forEach(d => { d.open = true; });
                })()""",
                "returnByValue": True,
            },
        )
        tab = {
            "key": "Tab",
            "code": "Tab",
            "windowsVirtualKeyCode": 9,
            "nativeVirtualKeyCode": 9,
        }
        for _ in range(80):
            estado = llamar(
                "Runtime.evaluate",
                {
                    "expression": """(() => {
                      const activo = document.activeElement;
                      return !!(activo && activo.classList && activo.classList.contains('tabla-scroll'));
                    })()""",
                    "returnByValue": True,
                },
            )["result"]["result"]["value"]
            if estado:
                break
            llamar("Input.dispatchKeyEvent", {"type": "keyDown", **tab})
            llamar("Input.dispatchKeyEvent", {"type": "keyUp", **tab})
        expresion = """(() => {
          const tabla = document.querySelector('body[data-pantalla="resumen"] .tabla-scroll');
          const activo = document.activeElement;
          if (!tabla || !activo) return {ok: false, motivo: "sin tabla"};
          const estilo = getComputedStyle(activo);
          return {
            ok: activo === tabla,
            clase: String(activo.className || ""),
            focoVisible: activo.matches(":focus-visible"),
            outlineStyle: estilo.outlineStyle,
            outlineWidth: estilo.outlineWidth,
            outlineColor: estilo.outlineColor
          };
        })()"""
        foco = llamar("Runtime.evaluate", {"expression": expresion, "returnByValue": True})[
            "result"
        ]["result"]["value"]
        llamar(
            "Emulation.setDeviceMetricsOverride",
            {"width": 390, "height": 844, "deviceScaleFactor": 1, "mobile": True},
        )
        time.sleep(0.3)
        anchos = llamar(
            "Runtime.evaluate",
            {
                "expression": """(() => {
                  const tabla = document.querySelector('.tabla-scroll');
                  const body = document.body;
                  return {
                    ancho: window.innerWidth,
                    bodyScroll: body.scrollWidth > body.clientWidth + 1,
                    tablaScroll: !!(tabla && tabla.scrollWidth > tabla.clientWidth + 1)
                  };
                })()""",
                "returnByValue": True,
            },
        )["result"]["result"]["value"]
        toma = llamar("Page.captureScreenshot", {"format": "png"})
        png.write_bytes(base64.b64decode(toma["result"]["data"]))
        salida = {"foco": foco, "ancho390": anchos, "png": png.is_file() and png.stat().st_size > 0}
        detalle.write_text(json.dumps(salida, indent=2) + "\n", encoding="utf-8")
        sock.close()
        return salida
    except Exception as exc:
        detalle.write_text(f"foco fallo: {exc}\n", encoding="utf-8")
        return {}
    finally:
        if proc is not None and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
        if perfil is not None:
            shutil.rmtree(perfil, ignore_errors=True)


def _chrome_screenshot(
    url: str, png: Path, stderr_path: Path, timeout_s: int = 30, ancho: int = 1280, alto: int = 900
) -> bool:
    """Toma screenshot con Chrome headless.

    Retorna true solo si el png existe y tiene tamano > 0.
    """

    png.unlink(missing_ok=True)
    chrome = _navegador()
    try:
        shot = subprocess.run(
            [
                chrome,
                "--headless=new",
                "--disable-gpu",
                "--no-sandbox",
                "--disable-dev-shm-usage",
                "--hide-scrollbars",
                f"--window-size={ancho},{alto}",
                f"--screenshot={png}",
                url,
            ],
            cwd=str(REPO_ROOT),
            capture_output=True,
            text=True,
            timeout=timeout_s,
        )
        if shot.returncode != 0:
            stderr_path.write_text(shot.stderr, encoding="utf-8")
            return False
    except subprocess.TimeoutExpired as exc:
        stderr_path.write_text(f"chrome timeout {timeout_s}s: {exc}\n", encoding="utf-8")
    except OSError as exc:
        stderr_path.write_text(f"chrome no ejecutable ({chrome}): {exc}\n", encoding="utf-8")
    return png.is_file() and png.stat().st_size > 0


def _cmdline(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\x00", b" ").decode()
    except OSError:
        pass
    try:
        salida = subprocess.run(
            ["ps", "-p", str(pid), "-o", "command="],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return salida.stdout.strip()


def _pid_vive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def _puerto_escucha_127(puerto: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.settimeout(1)
        return sock.connect_ex(("127.0.0.1", puerto)) == 0


def _inode_listen_127(puerto: int) -> str | None:
    """Inode de un listener 127.0.0.1:puerto en /proc/net/tcp (hex)."""
    objetivo = f"0100007F:{puerto:04X}"
    try:
        lineas = Path("/proc/net/tcp").read_text(encoding="utf-8").splitlines()[1:]
    except OSError:
        return None
    for linea in lineas:
        partes = linea.split()
        if len(partes) < 10:
            continue
        local, estado, inode = partes[1], partes[3], partes[9]
        if local.upper() == objetivo and estado == "0A":
            return inode
    return None


def _pid_tiene_inode(pid: int, inode: str) -> bool:
    fd_dir = Path(f"/proc/{pid}/fd")
    try:
        for fd in fd_dir.iterdir():
            try:
                destino = os.readlink(fd)
            except OSError:
                continue
            if destino == f"socket:[{inode}]":
                return True
    except OSError:
        return False
    return False


