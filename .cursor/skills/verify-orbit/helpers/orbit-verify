        "INSERT INTO config_version (label, settings) VALUES (%s, %s) RETURNING id",
        ("verify-orbit", Json({"ads_optimizer_mode": "shadow"})),
    ).fetchone()[0]
    camp_id = conn.execute(
        "INSERT INTO ad_entity (platform, kind, external_id, name)"
        " VALUES ('amazon_us', 'campaign', '9001', 'Campana A') RETURNING id"
    ).fetchone()[0]
    ag_id = conn.execute(
        "INSERT INTO ad_entity (platform, kind, external_id, parent_id)"
        " VALUES ('amazon_us', 'ad_group', '9101', %s) RETURNING id",
        (camp_id,),
    ).fetchone()[0]
    # A7 B3: la hoja existe para congelar (sin state ni metricas: invisible
    # para inertes y resumen, visible para target_acos_ciclo).
    hoja_id = conn.execute(
        "INSERT INTO ad_entity (platform, kind, external_id, parent_id, match_type,"
        " keyword_text) VALUES ('amazon_us', 'keyword', '9201', %s, 'EXACT', 'kw drive')"
        " RETURNING id",
        (ag_id,),
    ).fetchone()[0]
    # Campana B: con actividad 30d pero SIN freeze (caso null-honesto).
    # Metrica en hoy-10: inmadura para contribucion (90d maduros), dentro
    # de 30d para /campanas, fuera de la fila seed (hoy-15) de resumen.
    camp_b_id = conn.execute(
        "INSERT INTO ad_entity (platform, kind, external_id, name)"
        " VALUES ('amazon_us', 'campaign', '9002', 'Campana B') RETURNING id"
    ).fetchone()[0]
    conn.execute(
        "INSERT INTO ad_entity_state (ad_entity_id, current_bid, bid_currency, status,"
        " synced_at) VALUES (%s, 1.00, 'USD', 'ENABLED', %s)",
        (camp_b_id, decided_at),
    )
    # A8 (ARREGLOS 01 J): /salud mide la ultima corrida ok del sync de
    # estructura con acta por plataforma, no ad_entity_state.synced_at.
    run_estructura = conn.execute(
        "INSERT INTO ingest_run (source, started_at, ok)"
        " VALUES ('amazon_ads_structure_v2', %s, true) RETURNING id",
        (decided_at,),
    ).fetchone()[0]
    conn.execute(
        "INSERT INTO ads_listado_plataforma (ingest_run_id, platform,"
        " ad_groups_recibidos, product_ads_recibidos, product_ads_sin_grupo)"
        " VALUES (%s, 'amazon_us', 0, 0, 0)",
        (run_estructura,),
    )
    conn.execute(
        "INSERT INTO ads_metric_observation (ad_entity_id, metric_date, observed_at,"
        " metric_currency, cost, ad_revenue, impressions, clicks, orders, ingest_run_id)"
        " VALUES (%s, %s, %s, 'USD', 1.0000, 2.0000, 10, 1, 0, %s)",
        (
            camp_b_id,
            hoy - timedelta(days=10),
            datetime.now(UTC),
            run_id,
        ),
    )
    conn.execute(
        "INSERT INTO ads_metric_observation (ad_entity_id, metric_date, observed_at,"
        " metric_currency, cost, ad_revenue, impressions, clicks, orders, ingest_run_id)"
        " VALUES (%s, %s, %s, 'USD', 12.3400, 45.6700, 100, 8, 2, %s)",
        (
            camp_id,
            metric_date,
            datetime(metric_date.year, metric_date.month, metric_date.day, 1, tzinfo=UTC),
            run_id,
        ),
    )
    conn.execute(
        "INSERT INTO ad_entity_state (ad_entity_id, current_bid, bid_currency, status,"
        " acos_target, synced_at) VALUES (%s, 1.00, 'USD', 'ENABLED', 25.00, %s)",
        (camp_id, decided_at),
    )
    conn.execute(
        "INSERT INTO ads_optimizer_goal (scope, platform, target_acos_pct, bid_floor,"
        " bid_ceiling, bid_currency, enabled, mode)"
        " VALUES ('platform', 'amazon_us', 25.00, 0.10, 2.50, 'USD', true, 'shadow')"
    )
    # A7 B3: ciclo live+done ANTES del shadow (id menor): /salud sigue
    # tomando el shadow con DISTINCT ON, y el freeze tiene donde vivir.
    ciclo_live_id = conn.execute(
        "INSERT INTO optimizer_cycle (motor, mode, platform, status, finished_at,"
        " decisions_count) VALUES"
        " ('ads_optimizer', 'live', 'amazon_us', 'done', %s, 1) RETURNING id",
        (decided_at,),
    ).fetchone()[0]
    conn.execute(
        "INSERT INTO target_acos_ciclo (cycle_id, ad_entity_id, decided_at,"
