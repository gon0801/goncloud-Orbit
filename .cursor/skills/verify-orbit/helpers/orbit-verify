def _get_html(base_url: str, path: str, timeout_s: float = 5.0) -> tuple[int, bytes]:
    st, _, body = _http(f"{base_url}{path}", timeout=timeout_s)
    return st, body


def _tramo(texto: str, inicio: str, fin: str = "<h2>") -> str:
    """Tramo del HTML entre dos marcas; vacio si falta la marca inicial."""
    if inicio not in texto:
        return ""
    return texto.split(inicio, 1)[1].split(fin, 1)[0]


def _bloque_css(css: str, marca: str) -> str:
    """Bloque CSS completo (llaves incluidas) que empieza en `marca`."""
    inicio = css.find(marca)
    if inicio < 0:
        return ""
    abre = css.find("{", inicio)
    if abre < 0:
        return ""
    nivel = 0
    for i in range(abre, len(css)):
        if css[i] == "{":
            nivel += 1
        elif css[i] == "}":
            nivel -= 1
            if nivel == 0:
                return css[abre : i + 1]
    return ""


