            ciclo_id,
            camp_id,
            decided_at,
            config_id,
            decided_at - timedelta(hours=1),
            window_start,
            window_end,
            Json(
                {
                    "motor": "bid",
                    "motivo": "banda_menos_12",
                    "target_acos_pct_usado": "25.00",
                }
            ),
        ),
    ).fetchone()[0]
    neg_id = conn.execute(
        "INSERT INTO decision (cycle_id, ad_entity_id, kind, decided_at, config_version_id,"
        " data_observed_at, window_start, window_end, search_term, inputs)"
        " VALUES (%s, %s, 'negative', %s, %s, %s, %s, %s, 'zapato blanco', %s)"
        " RETURNING id",
        (
            ciclo_id,
            ag_id,
            decided_at,
            config_id,
            decided_at - timedelta(hours=1),
            window_start,
            window_end,
            Json({"motivo": "term_sin_ventas"}),
        ),
    ).fetchone()[0]
    queue_id = conn.execute(
        "INSERT INTO apply_queue (platform, ad_entity_id, kind, search_term, decision_id,"
        " modo, estado, vence_el, request_payload) VALUES"
        " ('amazon_us', %s, 'negative', 'zapato blanco', %s, 'live', 'pending_veto',"
        " %s, '{}'::jsonb) RETURNING id",
        (ag_id, neg_id, decided_at + timedelta(hours=48)),
    ).fetchone()[0]
    return {
        "campaign_id": camp_id,
        "campaign_name": "Campana A",
        "metric_date": metric_date.isoformat(),
        "hoy_utc": hoy.isoformat(),
        "decision_bid_id": bid_id,
        "queue_id": queue_id,
        "target_peldano": "goal_plataforma",
        "target_valor": "25.00",
    }


def _sembrar_productos(conn) -> dict:
    """AUTO-03 E.2: un ciclo done de amazon_mx con dos evaluaciones de producto
    armadas con el resolutor real y guardadas con productos_io (lo mismo que
    escribe el ciclo): Collar demo con meta 4 % (margen 8 % x fraccion 0.5) en
    un grupo exclusivo cuya keyword pasa de Mantener a Mover con la meta, y
    Aretes demo sin meta por halo_sin_margen. Reusa la config de la semilla.
    AUTO-03 H: el mismo ciclo, con la pausa en practica, guarda tambien las
    evaluaciones de Pulsera, Anillo y Broche leidas con el lector real sobre
    _sembrar_pausa (Pulsera con dos propuestas de pausa); la simulacion de H.8
    lee esa misma semilla."""
    from psycopg.types.json import Json

    if str(REPO_ROOT) not in sys.path:
        sys.path.insert(0, str(REPO_ROOT))
    from app import productos_io
    from app.cycle import lee_goals
    from app.optimizer import goals as g
    from app.optimizer import productos as p

    ahora = datetime.now(UTC)
    hoy = ahora.date()
    config_id = conn.execute("SELECT max(id) FROM config_version").fetchone()[0]

    def entidad(kind: str, externo: str, padre: int | None = None, **extra) -> int:
        columnas = ["platform", "kind", "external_id", "parent_id", *extra]
        return conn.execute(
            f"INSERT INTO ad_entity ({', '.join(columnas)}) VALUES"
            f" ({', '.join(['%s'] * len(columnas))}) RETURNING id",
            ("amazon_mx", kind, externo, padre, *extra.values()),
        ).fetchone()[0]

    camp = entidad("campaign", "9301", name="Campana P")
    grupo = entidad("ad_group", "9311", camp, name="Grupo collar")
    hoja = entidad("keyword", "9321", grupo, match_type="EXACT", keyword_text="collar plata")
    collar, aretes = (
        conn.execute(
            "INSERT INTO product (odoo_sku, name) VALUES (%s, %s) RETURNING id", fila
        ).fetchone()[0]
        for fila in (("PV-COLLAR", "Collar demo"), ("PV-ARETES", "Aretes demo"))
