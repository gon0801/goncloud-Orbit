def cmd_drive_productos(args: argparse.Namespace) -> None:
    run_id = args.run_id or _latest_run_id()
    state = _load_state(run_id)
    base = state["base_url"]
    if any(h in base for h in FORBIDDEN_HOSTS) or state["port"] in FORBIDDEN_PORTS:
        _die(f"rehuso conducir {base}: no es instancia local de verificacion")
    semilla = state["seed"]["productos"]

    evidence = _evidence_dir(run_id) / "productos"
    evidence.mkdir(parents=True, exist_ok=True)

    st0, html0 = _get_html(base, "/")
    (evidence / "01-resumen.html").write_bytes(html0)
    if st0 != 200 or 'href="/productos-sin-clics"' not in html0.decode("utf-8", errors="replace"):
        _die(f"punto de partida GET / sin enlace a Productos sin clics: {st0}")

    st_mx, html_mx = _get_html(base, "/productos-sin-clics?plataforma=amazon_mx")
    (evidence / "02-productos-mx.html").write_bytes(html_mx)
    texto = html_mx.decode("utf-8", errors="replace")
    inicio = texto.find('id="decisiones-producto"')
    seccion = texto[inicio:] if inicio >= 0 else ""
    filas = seccion.split('<tr data-decision-producto="')[1:]

    def fila(producto: int) -> str:
        return next((f for f in filas if f.startswith(f'{producto}"')), "")

    fila_collar = fila(semilla["collar"])
    fila_aretes = fila(semilla["aretes"])

    checks: dict[str, bool] = {
        "http_200": st_mx == 200,
        "data-pantalla=productos-sin-clics": 'data-pantalla="productos-sin-clics"' in texto,
        "seccion_meta_por_producto": "Meta por producto" in seccion,
        "chip_1_de_5_con_meta": "1 de 5 con meta" in seccion,
        "ciclo_en_practica": f"Ciclo {semilla['cycle_id']}" in seccion
        and "<strong>en práctica</strong>" in seccion,
        "filtro": 'id="decisiones-filtro"' in seccion
        and 'value="motivo:halo_sin_margen"' in seccion,
        "collar_meta_4": "Collar demo" in fila_collar and "<strong>4.00 %</strong>" in fila_collar,
        "collar_margen_y_ventana": "8.00 %" in fila_collar,
        "collar_grupo_y_campana": "Grupo collar" in fila_collar and "Campana P" in fila_collar,
        "hoja_target_vigente": "collar plata" in fila_collar
        and "10.00 %" in fila_collar
        and "Margen de la plataforma" in fila_collar,
        "hoja_veredicto_actual_vs_meta": "Mantener · Dentro de banda" in fila_collar
        and "Mover -12.00 % a 0.88 · Acos sobre target" in fila_collar
        and ">cambia<" in fila_collar,
        "aretes_sin_meta_por_halo": "Aretes demo" in fila_aretes
        and "sin meta" in fila_aretes
        and "ventas atribuidas de otro SKU" in fila_aretes
        and "ningún grupo exclusivo" in fila_aretes,
    }

    # productos-pausa (H.5): propuestas marcadas sin efecto con la pausa en
    # practica, gasto observado frente al actuable, anuncios y motivos.
    pausa = _tramo(texto, 'id="pausa-producto"', 'id="productos-limites"')
    filas_pausa = pausa.split('<tr data-pausa-producto="')[1:]

    def fila_pausa(producto: int) -> str:
        return next((f for f in filas_pausa if f.startswith(f'{producto}"')), "")

    f_pulsera = fila_pausa(semilla["pulsera"])
    f_anillo = fila_pausa(semilla["anillo"])
    f_broche = fila_pausa(semilla["broche"])
    propuestas = [f_pulsera.split(f'data-propuesta="{a}"')[1:] for a in semilla["propuestos"]]
    checks.update(
        {
            "pausa_seccion": "Pausa por producto" in pausa
            and "1 de 5 con propuesta" in pausa
            and "<strong>en práctica</strong>" in pausa
            and "no pausan ningún anuncio" in pausa,
            "pausa_pulsera_primero": bool(filas_pausa)
            and filas_pausa[0].startswith(f'{semilla["pulsera"]}"'),
            "pausa_pulsera_gasto_observado_vs_actuable": "Pulsera demo" in f_pulsera
            and "600.00 MXN" in f_pulsera
            and "150 clics" in f_pulsera
            and re.search(r"data-gasto-actuable>\s*400\.00 MXN", f_pulsera) is not None,
            "pausa_pulsera_anuncios": "2 al alcance" in f_pulsera
            and 'data-excluido="alta_en_ventana"' in f_pulsera
            and "1 fuera: el anuncio no existia antes de la ventana" in f_pulsera,
            "pausa_propuestas_sin_efecto": all(
                p and "propuesta, sin efecto" in p[0].split("</li>")[0] for p in propuestas
            )
            and "Grupo pulsera A" in f_pulsera
            and "Grupo pulsera B" in f_pulsera
            and "9421" in f_pulsera,
            "pausa_confirmados_de_total": re.search(r"data-confirmados>\s*0 de 2", f_pulsera)
            is not None,
            "pausa_anillo_vendio": 'data-motivo-pausa="vendio_en_ventana"' in f_anillo
            and re.search(r"data-confirmados>\s*0 de 0", f_anillo) is not None,
            "pausa_broche_sin_dato_es_raya": re.search(r"data-gasto-observado>\s*—", f_broche)
            is not None
            and 'data-motivo-actividad="fecha_desconocida"' in f_broche
            and re.search(r"data-gasto-actuable>\s*—", f_broche) is not None,
        }
    )

    # productos-limites (H.9): campos con los vigentes y el guardado con token.
    limites = _tramo(texto, 'id="productos-limites"', 'id="productos-retiro"')
    checks.update(
        {
            "limites_vigentes": "Vigentes: <strong>100 clics</strong> y "
            "<strong>500.00 MXN</strong>" in limites,
            "limites_campos": re.search(r'id="limites-clics"[^>]*value="100"', limites) is not None
            and re.search(r'id="limites-gasto"[^>]*value="500"', limites) is not None
            and 'for="limites-clics"' in limites
            and 'for="limites-gasto"' in limites
            and "Gasto mínimo (MXN)" in limites,
            "limites_simular_y_guardar": 'id="limites-simular"' in limites
            and ">Simular sin guardar</button>" in limites
            and f'data-config-id="{semilla["config_version_id"]}"' in limites
            and 'type="password" id="limites-token"' in limites
            and ">Guardar límites</button>" in limites
            and 'role="status"' in limites,
            # h_c4a60451: sin las claves en la config los vigentes son los de
            # omision y la pantalla deja guardarlos tal cual.
            "limites_por_omision_guardables": 'data-guardados="false"' in limites
            and "(por omisión, todavía sin guardar)" in limites,
        }
    )

    st_us, html_us = _get_html(base, "/productos-sin-clics?plataforma=amazon_us")
    (evidence / "03-productos-us.html").write_bytes(html_us)
    texto_us = html_us.decode("utf-8", errors="replace")
    checks["us_ciclo_sin_evaluar"] = (
        st_us == 200
        and 'id="decisiones-producto"' in texto_us
        and "Este ciclo no evaluó productos: la meta está apagada" in texto_us
    )
    checks["us_limites_en_usd"] = (
        'id="pausa-producto"' not in texto_us
        and "Vigentes: <strong>100 clics</strong> y <strong>40.00 USD</strong>" in texto_us
    )

    stj, _, rawj = _http(f"{base}/api/dashboard/productos-sin-clics?plataforma=amazon_mx")
    (evidence / "04-productos-mx.json").write_bytes(rawj)
    dp = json.loads(rawj.decode("utf-8")).get("decisiones_producto", {}) if stj == 200 else {}
    productos = {pr["product_id"]: pr for pr in dp.get("productos", [])}
    collar = productos.get(semilla["collar"], {})
    aretes = productos.get(semilla["aretes"], {})
    hojas = [h for gr in collar.get("grupos", []) for h in gr["hojas"]]
    checks["api_http_200"] = stj == 200
    checks["api_ciclo_y_conteo"] = (
        dp.get("cycle_id") == semilla["cycle_id"] and dp.get("con_meta") == 1
    )
    checks["api_collar"] = collar.get("meta_pct") == "4.00" and [
        h.get("cambia") for h in hojas
    ] == [True]
    checks["api_aretes"] = aretes.get("meta_pct") is None and "halo_sin_margen" in [
        m["codigo"] for m in aretes.get("motivos", [])
    ]
    api_pausa = dp.get("pausa") or {}
    pausas = {pr["product_id"]: pr for pr in api_pausa.get("productos", [])}
    pulsera = pausas.get(semilla["pulsera"], {})
    checks["api_pausa"] = (
        api_pausa.get("modo") == "shadow"
        and pulsera.get("gasto_observado") == "600.00"
        and pulsera.get("gasto_actuable") == "400.00"
        and pulsera.get("total") == 2
        and pulsera.get("confirmados") == 0
        and [a["ad_entity_id"] for a in pulsera.get("propuestas", [])] == semilla["propuestos"]
        and pausas.get(semilla["broche"], {}).get("gasto_observado", 0) is None
    )
    limites_antes = dp.get("limites_pausa") or {}
    checks["api_limites_vigentes"] = limites_antes == {
        "config_version_id": semilla["config_version_id"],
        "clics": 100,
        "gasto": "500",
        "gasto_texto": "500.00",
        "moneda": "MXN",
        "error": None,
        "guardados": False,
        "modo": "off",
        "modo_texto": "Apagada",
        "modo_error": None,
    }

    checks.update(_simula_limites(base, evidence, semilla, limites_antes))

    stjs, _, js = _http(f"{base}/static/js/productos.js")
    checks["js_filtro_cableado"] = stjs == 200 and b'getElementById("decisiones-filtro")' in js
    checks["js_limites_cableado"] = stjs == 200 and all(
        marca.encode() in js
        for marca in (
            'getElementById("limites-simular")',
            "/api/dashboard/productos/simula-pausa?platform=",
            '"/api/ads-optimizer/settings/"',
            '"x-orbit-token"',
            "El gasto pasado no es ahorro seguro",
            "Gasto que se habría evitado",
            "Ventas que se habrían perdido",
            "Hay datos del reporte de productos desde el ",
        )
    )
    checks["js_encender_cableado"] = stjs == 200 and all(
        marca.encode() in js
        for marca in (
            'getElementById("pausa-encender")',
            'getElementById("pausa-volver")',
            'getElementById("pausa-cancelar")',
            '"/api/dashboard/productos/simula-pausa?platform="',
            '"/api/ads-optimizer/productos/pausa/"',
            "base_config_version_id: Number(p.caja.dataset.configId)",
            "Cancelado: no se cambió nada.",
            "Recarga la página.",
        )
    )

    # productos-encender (I.8): al final, porque escribe config en la base
    # desechable (los checks de arriba leen la semilla tal cual).
    checks.update(_encender_pausa(base, state["dsn"], evidence, semilla))

    prueba = {
        "feature": "productos",
        "entry_point": "nav /productos-sin-clics",
        "base_url": base,
        "action": "GET /productos-sin-clics (mx y us), GET /api/dashboard/productos-sin-clics, "
        "GET /api/dashboard/productos/simula-pausa (vigentes, otros limites y bajo el piso), "
        "GET /static/js/productos.js; productos-encender: GET /api/dashboard/productos/pausa "
        "sin limites, en practica y con limites guardados, simulacion de encender, cancelar "
        "sin escribir, en vivo y de vuelta a practica",
        "checks": checks,
        "ok": all(checks.values()),
        "evidence_dir": str(evidence),
    }
    (evidence / "PROOF.json").write_text(json.dumps(prueba, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(prueba, indent=2))
    if not prueba["ok"]:
        fallaron = [k for k, v in checks.items() if not v]
        _die("drive-productos FALLA: " + ", ".join(fallaron))


def cmd_drive_maintain_verification_skill(args: argparse.Namespace) -> None:
    run_id = args.run_id or _run_id()
    port = args.port

    # El rechazo de un run existente no adquiere su propiedad para cleanup.
    if _state_path(run_id).is_file() and not args.force:
        _die(f"ya existe {_state_path(run_id)}: usa otro --run-id o cleanup")
    launch_args = argparse.Namespace(run_id=run_id, port=port, force=args.force)

    try:
        cmd_launch(launch_args)
        doctor_args = argparse.Namespace(run_id=run_id)
        cmd_doctor(doctor_args)

        drive_args = argparse.Namespace(run_id=run_id)
        for drive in (
            cmd_drive_resumen,
            cmd_drive_campanas,
            cmd_drive_decisiones,
            cmd_drive_salud,
            cmd_drive_contribucion,
            cmd_drive_cortes,
            cmd_drive_inertes,
            cmd_drive_fabrica,
            cmd_drive_settings,
            cmd_drive_productos,
        ):
            try:
                drive(drive_args)
            except SystemExit:
                with contextlib.suppress(SystemExit):
                    cmd_doctor(doctor_args)
                raise

    finally:
        if _state_path(run_id).is_file():
            cmd_cleanup(argparse.Namespace(run_id=run_id))

    out = {
        "ok": True,
        "run_id": run_id,
        "evidence_root": str(_evidence_dir(run_id)),
        "scratch_dir": str(_scratch(run_id)),
    }
    print(json.dumps(out, indent=2))


def cmd_cleanup(args: argparse.Namespace) -> None:
    run_id = args.run_id or _latest_run_id()
    ruta = _state_path(run_id)
    if not ruta.is_file():
        print(f"orbit-verify: nada que limpiar para {run_id}")
        return
    state = json.loads(ruta.read_text(encoding="utf-8"))
    pid = int(state["pid"])
    _cleanup_proceso(pid)
    import psycopg
    from psycopg import sql as pgsql

    db_dropeada = True
    try:
        admin = psycopg.connect(ADMIN_DSN, autocommit=True)
        admin.execute(
            pgsql.SQL("DROP DATABASE IF EXISTS {} WITH (FORCE)").format(
                pgsql.Identifier(state["db"])
            )
        )
        admin.close()
    except Exception as exc:  # noqa: BLE001 — cleanup best-effort de la DB
        db_dropeada = False
        print(f"orbit-verify: aviso al dropear {state['db']}: {exc}", file=sys.stderr)

    scratch = Path(state.get("scratch_dir") or _scratch(run_id))
    if db_dropeada and scratch.is_dir():
        shutil.rmtree(scratch, ignore_errors=True)
    elif not db_dropeada:
        print(
            f"orbit-verify: conservo {scratch} para reintentar el drop de {state['db']}",
            file=sys.stderr,
        )

    evidencia = Path(state["evidence_dir"])
    if not evidencia.is_dir():
        _die(f"cleanup termino pero la evidencia desaparecio: {evidencia}")
    print(
        json.dumps(
            {
                "cleaned_run_id": run_id,
                "killed_pid": pid,
                "dropped_db": state["db"] if db_dropeada else None,
                "evidence_still_at": str(evidencia),
            }
        )
    )


