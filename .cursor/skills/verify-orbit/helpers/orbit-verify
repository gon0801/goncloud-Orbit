FORBIDDEN_PORTS = {8010}

# Migraciones de DATOS (no esquema): exigen filas de produccion (SKU, costos).
# La base desechable no las tiene — misma excepcion que test_schema.py (0011
# no entra al arbol de esquema). Incluye la reversa: tampoco aplica en vacio.
MIGRACIONES_DATOS = frozenset(
    {
        "0011_costo_historico_peseta.sql",
        "0011_reversa_costo_historico_peseta.sql",
    }
)


def _migration_files() -> list[Path]:
    """SQL de esquema, en orden de nombre.

    Omite nombres en MIGRACIONES_DATOS. Si un prefijo NNNN tiene un sibling
    `*_reversa_*`, ese prefijo es un parche de catalogo vivo (hoy 0011) y no
    aplica en una base vacia. tests/test_schema.py omite 0011 por la misma razon.
    """
    files = sorted(
        (
            p
            for p in MIGRATIONS.glob("*.sql")
            if p.name[:4].isdigit() and p.name not in MIGRACIONES_DATOS
        ),
        key=lambda p: p.name,
    )
    if not files:
        _die(f"no hay migraciones numeradas en {MIGRATIONS}")
    prefixes_con_reversa = {p.name[:4] for p in files if "_reversa_" in p.name}
    esquema = [p for p in files if p.name[:4] not in prefixes_con_reversa]
    if not esquema:
        _die(f"no quedo SQL de esquema en {MIGRATIONS}")
    return esquema


def _die(msg: str, code: int = 1) -> None:
    print(f"orbit-verify: {msg}", file=sys.stderr)
    raise SystemExit(code)


def _run_id() -> str:
    return os.environ.get("ORBIT_VERIFY_RUN_ID") or datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")


def _scratch(run_id: str) -> Path:
    return SCRATCH_ROOT / run_id


def _state_path(run_id: str) -> Path:
    return _scratch(run_id) / "state.json"


def _load_state(run_id: str) -> dict:
    ruta = _state_path(run_id)
    if not ruta.is_file():
        _die(f"no hay estado en {ruta}: corre launch primero")
    return json.loads(ruta.read_text(encoding="utf-8"))


def _save_state(state: dict) -> None:
    ruta = _state_path(state["run_id"])
    ruta.parent.mkdir(parents=True, exist_ok=True)
    ruta.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")


def _evidence_dir(run_id: str) -> Path:
    destino = EVIDENCE_ROOT / run_id
    destino.mkdir(parents=True, exist_ok=True)
    return destino


def _latest_run_id() -> str:
    env = os.environ.get("ORBIT_VERIFY_RUN_ID")
    if env:
        return env
    if not SCRATCH_ROOT.is_dir():
        _die("no hay runs en /tmp/orbit-verify: corre launch")
    candidatos = sorted(
        (p for p in SCRATCH_ROOT.iterdir() if (p / "state.json").is_file()),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    if not candidatos:
        _die("no hay state.json en /tmp/orbit-verify: corre launch")
    return candidatos[0].name


def _ensure_postgres() -> None:
    import psycopg

    try:
        with psycopg.connect(ADMIN_DSN, connect_timeout=3):
            return
    except psycopg.Error:
        pass
    if not START_SH.is_file():
        _die(
            "Postgres no acepta postgresql://orbit:orbit@127.0.0.1:5432/postgres "
            f"y no existe {START_SH}"
        )
    print("orbit-verify: arrancando Postgres local via .cursor/start.sh")
    subprocess.run(["bash", str(START_SH)], check=True, cwd=str(REPO_ROOT))
    last: Exception | None = None
    for _ in range(30):
        try:
            with psycopg.connect(ADMIN_DSN, connect_timeout=2):
                return
        except psycopg.Error as exc:
            last = exc
            time.sleep(1)
    _die(f"Postgres sigue sin aceptar el DSN de test tras start.sh: {last}")


def _puerto_libre(preferido: int) -> int:
    if preferido in FORBIDDEN_PORTS:
        _die(f"puerto {preferido} esta reservado a produccion (compose 8010)")
    for puerto in range(preferido, preferido + 50):
        if puerto in FORBIDDEN_PORTS:
            continue
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                sock.bind(("127.0.0.1", puerto))
            except OSError:
                continue
            return puerto
    _die(f"no hay puerto libre a partir de {preferido} en 127.0.0.1")


def _aplicar_migraciones(conn) -> None:
    for ruta in _migration_files():
        conn.execute(ruta.read_text(encoding="utf-8"))


