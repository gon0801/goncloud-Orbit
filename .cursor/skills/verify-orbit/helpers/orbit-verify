def _sembrar_pausa(conn, entidad, ahora: datetime, hoja: int) -> dict:
    """AUTO-03 H.5/H.8: tres productos de amazon_mx con product ads ENABLED en
    Campana Q (goal de plataforma live) y filas del reporte de productos de
    D-90 a D-31, maduras y con sus ad_ids. Pulsera gasta sin vender (150 clics,
    600 MXN en [D-60, D-30)): propone pausar sus dos anuncios viejos; el tercero
    nacio en la ventana (alta_en_ventana) y sus filas no son gasto sobre el que
    Orbit pueda actuar (400 de 600). Anillo vendio despues de una ventana
    anterior sin ventas (ventas que se habrian perdido). Broche tiene huecos sin
    cobertura D.7 (fecha_desconocida). Una metrica reciente de la keyword del
    collar da el watermark del mercado."""
    from psycopg.types.json import Json

    hoy = ahora.date()
    run_id = conn.execute("SELECT max(id) FROM ingest_run").fetchone()[0]
    conn.execute(
        "INSERT INTO ads_metric_observation (ad_entity_id, metric_date, observed_at,"
        " metric_currency, cost, ad_revenue, impressions, clicks, orders, ingest_run_id)"
        " VALUES (%s, %s, %s, 'MXN', 1.0000, 0.0000, 10, 1, 0, %s)",
        (hoja, hoy - timedelta(days=2), ahora, run_id),
    )
    conn.execute(
        "INSERT INTO ads_optimizer_goal (scope, platform, bid_floor, bid_ceiling, bid_currency,"
        " enabled, mode) VALUES ('platform', 'amazon_mx', 1.00, 10.00, 'MXN', true, 'live')"
