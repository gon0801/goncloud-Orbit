        items = json.loads(rawj.decode("utf-8")).get("items") or []
    checks["api_200"] = stj == 200
    checks["api_misma_campana"] = any(
        i.get("nombre") == "Campana A" and i.get("plataforma") == "amazon_us" for i in items
    )
    checks["api_status_ENABLED"] = any(i.get("status") == "ENABLED" for i in items)
    checks["api_cost"] = any((i.get("metricas_30d") or {}).get("cost") == "12.3400" for i in items)
    checks["api_clicks"] = any((i.get("metricas_30d") or {}).get("clicks") == 8 for i in items)
    checks["api_acos"] = any((i.get("metricas_30d") or {}).get("acos") for i in items)
    checks["api_peldano"] = any(
        (i.get("target_efectivo") or {}).get("peldano") == "goal_plataforma" for i in items
    )

    png = evidence / "04-campanas.png"
    chrome = os.environ.get("ORBIT_VERIFY_CHROME", "google-chrome")
    try:
        shot = subprocess.run(
            [
                chrome,
                "--headless=new",
                "--disable-gpu",
                "--no-sandbox",
                "--disable-dev-shm-usage",
                "--hide-scrollbars",
                "--window-size=1280,900",
                f"--screenshot={png}",
                f"{base}/campanas",
            ],
            cwd=str(REPO_ROOT),
            capture_output=True,
            text=True,
            timeout=30,
        )
        if shot.returncode != 0:
            (evidence / "04-chrome.stderr.txt").write_text(shot.stderr, encoding="utf-8")
    except subprocess.TimeoutExpired as exc:
        (evidence / "04-chrome.stderr.txt").write_text(
            f"chrome timeout 30s: {exc}\n", encoding="utf-8"
        )
    except OSError as exc:
        (evidence / "04-chrome.stderr.txt").write_text(
            f"chrome no ejecutable ({chrome}): {exc}\n", encoding="utf-8"
        )
    checks["screenshot"] = png.is_file() and png.stat().st_size > 0

    prueba = {
        "feature": "campanas",
        "entry_point": "nav /campanas desde /",
        "base_url": base,
        "action": "GET / luego GET /campanas (mismo camino que el <a href=/campanas>)",
        "resulting_state": {
            "html_status": st,
            "api_status": stj,
            "items": items,
        },
        "checks": checks,
        "ok": all(v for k, v in checks.items() if k != "screenshot"),
        "evidence_dir": str(evidence),
    }
    (evidence / "PROOF.json").write_text(json.dumps(prueba, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(prueba, indent=2))
    if not prueba["ok"]:
        fallaron = [k for k, v in checks.items() if not v and k != "screenshot"]
        _die("drive-campanas FALLA: " + ", ".join(fallaron))


def cmd_cleanup(args: argparse.Namespace) -> None:
    run_id = args.run_id or _latest_run_id()
    ruta = _state_path(run_id)
    if not ruta.is_file():
        print(f"orbit-verify: nada que limpiar para {run_id}")
        return
    state = json.loads(ruta.read_text(encoding="utf-8"))
    pid = int(state["pid"])
    _cleanup_proceso(pid)
    import psycopg
    from psycopg import sql as pgsql

    db_dropeada = True
    try:
        admin = psycopg.connect(ADMIN_DSN, autocommit=True)
        admin.execute(
            pgsql.SQL("DROP DATABASE IF EXISTS {} WITH (FORCE)").format(
                pgsql.Identifier(state["db"])
            )
        )
        admin.close()
    except Exception as exc:  # noqa: BLE001 — cleanup best-effort de la DB
        db_dropeada = False
        print(f"orbit-verify: aviso al dropear {state['db']}: {exc}", file=sys.stderr)

    scratch = Path(state.get("scratch_dir") or _scratch(run_id))
    if db_dropeada and scratch.is_dir():
        shutil.rmtree(scratch, ignore_errors=True)
    elif not db_dropeada:
        print(
            f"orbit-verify: conservo {scratch} para reintentar el drop de {state['db']}",
            file=sys.stderr,
        )

    evidencia = Path(state["evidence_dir"])
    if not evidencia.is_dir():
        _die(f"cleanup termino pero la evidencia desaparecio: {evidencia}")
    print(
        json.dumps(
            {
                "cleaned_run_id": run_id,
                "killed_pid": pid,
                "dropped_db": state["db"] if db_dropeada else None,
                "evidence_still_at": str(evidencia),
            }
        )
    )


def main() -> None:
    parser = argparse.ArgumentParser(description="Verificacion local de Orbit")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_launch = sub.add_parser("launch", help="Levanta instancia local desechable")
    p_launch.add_argument("--run-id", default=None)
    p_launch.add_argument("--port", type=int, default=DEFAULT_PORT)
    p_launch.add_argument("--force", action="store_true")
    p_launch.set_defaults(func=cmd_launch)

    p_doc = sub.add_parser("doctor", help="Chequeo de solo lectura")
    p_doc.add_argument("--run-id", default=None)
    p_doc.set_defaults(func=cmd_doctor)

    p_drive = sub.add_parser("drive-campanas", help="Conduce la pantalla Campanas")
    p_drive.add_argument("--run-id", default=None)
    p_drive.set_defaults(func=cmd_drive_campanas)

    p_clean = sub.add_parser("cleanup", help="Tira la instancia de este run")
    p_clean.add_argument("--run-id", default=None)
    p_clean.set_defaults(func=cmd_cleanup)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
