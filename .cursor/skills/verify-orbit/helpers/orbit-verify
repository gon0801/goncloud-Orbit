def _http(url: str, timeout: float = 5.0) -> tuple[int, dict[str, str], bytes]:
    req = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            headers = {k.lower(): v for k, v in resp.headers.items()}
            return resp.status, headers, resp.read()
    except urllib.error.HTTPError as exc:
        headers = {k.lower(): v for k, v in exc.headers.items()} if exc.headers else {}
        return exc.code, headers, exc.read()


def _cmdline(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\x00", b" ").decode()
    except OSError:
        return ""


def _pid_vive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def _puerto_escucha_127(puerto: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.settimeout(1)
        return sock.connect_ex(("127.0.0.1", puerto)) == 0


def _inode_listen_127(puerto: int) -> str | None:
    """Inode de un listener 127.0.0.1:puerto en /proc/net/tcp (hex)."""
    objetivo = f"0100007F:{puerto:04X}"
    try:
        lineas = Path("/proc/net/tcp").read_text(encoding="utf-8").splitlines()[1:]
    except OSError:
        return None
    for linea in lineas:
        partes = linea.split()
        if len(partes) < 10:
            continue
        local, estado, inode = partes[1], partes[3], partes[9]
        if local.upper() == objetivo and estado == "0A":
            return inode
    return None


def _pid_tiene_inode(pid: int, inode: str) -> bool:
    fd_dir = Path(f"/proc/{pid}/fd")
    try:
        for fd in fd_dir.iterdir():
            try:
                destino = os.readlink(fd)
            except OSError:
                continue
            if destino == f"socket:[{inode}]":
                return True
    except OSError:
        return False
    return False


def cmd_launch(args: argparse.Namespace) -> None:
    import psycopg
    from psycopg import sql as pgsql

    run_id = args.run_id or _run_id()
    if _state_path(run_id).is_file() and not args.force:
        _die(f"ya existe {_state_path(run_id)}: usa otro --run-id o cleanup")

    _ensure_postgres()
    preferido = int(os.environ.get("ORBIT_VERIFY_PORT", args.port))
    puerto = _puerto_libre(preferido)
    db = f"orbit_verify_{run_id.lower().replace('-', '_')}"[:63]
    admin = psycopg.connect(ADMIN_DSN, autocommit=True)
    conn = None
    try:
        admin.execute(
            pgsql.SQL("DROP DATABASE IF EXISTS {} WITH (FORCE)").format(pgsql.Identifier(db))
        )
        admin.execute(pgsql.SQL("CREATE DATABASE {}").format(pgsql.Identifier(db)))
        conn = psycopg.connect(ADMIN_DSN, dbname=db, autocommit=True)
        conn.execute("SET TIME ZONE 'UTC'")
        _aplicar_migraciones(conn)
        semilla = _sembrar(conn)
    except Exception:
        if conn is not None:
            conn.close()
        try:
            admin.execute(
                pgsql.SQL("DROP DATABASE IF EXISTS {} WITH (FORCE)").format(pgsql.Identifier(db))
            )
        finally:
            admin.close()
        raise
    conn.close()
    admin.close()

    dsn = f"postgresql://orbit:orbit@127.0.0.1:5432/{db}"
    scratch = _scratch(run_id)
    scratch.mkdir(parents=True, exist_ok=True)
    evidence = _evidence_dir(run_id)
    log_path = scratch / "uvicorn.log"
    env = os.environ.copy()
    env["ORBIT_DSN_READ"] = dsn
    env.pop("ORBIT_PG_HOST", None)
    env.pop("ORBIT_DSN_ADMIN", None)
    env.pop("ORBIT_DSN_DECIDE", None)
    env.pop("ORBIT_DSN_INGEST", None)
    python = REPO_ROOT / ".venv" / "bin" / "python"
    if not python.is_file():
        _die(f"no existe {python}: corre uv sync")
    cmd = [
        str(python),
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        str(puerto),
    ]
    log_fh = log_path.open("w", encoding="utf-8")
    proc = subprocess.Popen(
        cmd,
        cwd=str(REPO_ROOT),
        env=env,
        stdout=log_fh,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    state = {
        "run_id": run_id,
        "pid": proc.pid,
        "port": puerto,
        "bind": "127.0.0.1",
        "base_url": f"http://127.0.0.1:{puerto}",
        "db": db,
        "dsn": dsn,
        "evidence_dir": str(evidence),
        "scratch_dir": str(scratch),
        "log_path": str(log_path),
        "repo_root": str(REPO_ROOT),
        "started_at": datetime.now(UTC).isoformat(),
        "seed": semilla,
        "cmd": cmd,
    }
    _save_state(state)
    listo = False
    for _ in range(40):
        if proc.poll() is not None:
            _die(
                f"uvicorn salio con {proc.returncode}. log: {log_path}\n"
                + log_path.read_text(encoding="utf-8")[-2000:]
            )
        try:
            status, _, body = _http(f"http://127.0.0.1:{puerto}/health", timeout=1.0)
        except (urllib.error.URLError, TimeoutError, OSError):
            time.sleep(0.25)
            continue
        if status == 200 and body.strip() == b'{"status":"ok"}':
            listo = True
            break
        time.sleep(0.25)
    if not listo:
        _cleanup_proceso(proc.pid)
        _die(f"uvicorn no respondio /health en 10s. log: {log_path}")

    ready = evidence / "launch-ready.txt"
    ready.write_text(
        f"base_url={state['base_url']}\n"
        f"pid={proc.pid}\n"
        f"db={db}\n"
        f"health={body.decode()}\n"
        f"seed={json.dumps(semilla)}\n",
        encoding="utf-8",
    )
    campos = ("run_id", "pid", "port", "base_url", "db", "evidence_dir")
    print(json.dumps({k: state[k] for k in campos}))


def _cleanup_proceso(pid: int) -> None:
    if not _pid_vive(pid):
        return
    cmdline = _cmdline(pid)
    if "uvicorn" not in cmdline or "app.main:app" not in cmdline:
        print(
            f"orbit-verify: pid {pid} no es uvicorn app.main:app ({cmdline!r}); no lo mato",
            file=sys.stderr,
        )
        return
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        return
    for _ in range(20):
        if not _pid_vive(pid):
            return
        time.sleep(0.1)
    try:
        os.kill(pid, signal.SIGKILL)
    except OSError:
        return


def cmd_doctor(args: argparse.Namespace) -> None:
    run_id = args.run_id or _latest_run_id()
    state = _load_state(run_id)
    fallos: list[str] = []

    if any(h in state["base_url"] for h in FORBIDDEN_HOSTS):
        fallos.append(f"base_url apunta a produccion VPN: {state['base_url']}")
    if state["port"] in FORBIDDEN_PORTS:
        fallos.append(f"puerto {state['port']} es el bind de produccion (8010)")
    if not state["base_url"].startswith("http://127.0.0.1:"):
        fallos.append(f"base_url no es loopback: {state['base_url']}")

    pid = int(state["pid"])
    if not _pid_vive(pid):
        fallos.append(f"pid {pid} no vive")
    cmdline = _cmdline(pid)
    if "uvicorn" not in cmdline or "app.main:app" not in cmdline:
        fallos.append(f"pid {pid} no es uvicorn app.main:app: {cmdline!r}")

    if not _puerto_escucha_127(state["port"]):
        fallos.append(f"127.0.0.1:{state['port']} no acepta TCP")
    inode = _inode_listen_127(state["port"])
    if inode and not _pid_tiene_inode(pid, inode):
        fallos.append(f"127.0.0.1:{state['port']} inode={inode} no pertenece al pid {pid}")

    try:
        status, headers, body = _http(f"{state['base_url']}/health")
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        fallos.append(f"/health no responde: {exc}")
        status, _, body = 0, {}, b""
    if status != 200 or body.strip() != b'{"status":"ok"}':
        fallos.append(f"/health inesperado: {status} {body!r}")

    try:
        st_html, hdr_html, html = _http(f"{state['base_url']}/")
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        fallos.append(f"GET / no responde: {exc}")
        st_html, hdr_html, html = 0, {}, b""
    texto = html.decode("utf-8", errors="replace")
    if st_html != 200:
        fallos.append(f"GET / -> {st_html} (sin DSN seria 503)")
    if 'data-pantalla="resumen"' not in texto:
        fallos.append("GET / no trae data-pantalla=resumen (build equivocado o 503)")
    if "Orbit — Dashboard" not in texto and "Orbit" not in texto:
        fallos.append("GET / no trae el titulo Orbit")
    if hdr_html.get("content-security-policy") != "default-src 'self'":
        fallos.append(f"CSP inesperada: {hdr_html.get('content-security-policy')}")
    if "no-store" not in (hdr_html.get("cache-control") or ""):
        fallos.append(f"Cache-Control inesperado: {hdr_html.get('cache-control')}")

    reporte = {
        "run_id": run_id,
        "ok": not fallos,
        "pid": pid,
        "port": state["port"],
        "base_url": state["base_url"],
        "cmdline": cmdline,
        "health": body.decode("utf-8", errors="replace"),
        "fallos": fallos,
    }
    dest = _evidence_dir(run_id) / "doctor.json"
    dest.write_text(json.dumps(reporte, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(reporte, indent=2))
    if fallos:
        _die("doctor FALLA: " + "; ".join(fallos))


