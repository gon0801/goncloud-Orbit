def _simula_limites(base: str, evidence: Path, semilla: dict, limites_antes: dict) -> dict:
    """productos-limites, simular sin guardar: la ruta de H.8 con los vigentes,
    con otros limites y bajo el piso (422 con el minimo); despues, los limites
    de la pantalla siguen iguales."""
    checks: dict[str, bool] = {}

    def simula(consulta: str, nombre: str) -> tuple[int, dict]:
        st, _, raw = _http(f"{base}/api/dashboard/productos/simula-pausa?{consulta}", timeout=15)
        (evidence / nombre).write_bytes(raw)
        try:
            return st, json.loads(raw.decode("utf-8"))
        except ValueError:
            return st, {}

    def dinero(dato, valor: str) -> bool:
        return (
            isinstance(dato, dict)
            and dato.get("tipo") == "Dinero"
            and dato.get("moneda") == "MXN"
            and Decimal(dato.get("valor", "NaN")) == Decimal(valor)
        )

    st_v, sim_v = simula("platform=amazon_mx", "05-simula-vigentes.json")
    productos_v = sim_v.get("productos") or []
    checks["simula_vigentes"] = (
        st_v == 200
        and sim_v.get("limites", {}).get("clics_min") == 100
        and [x["producto"]["product_id"] for x in productos_v] == [semilla["pulsera"]]
        and dinero(productos_v[0]["gasto"], "600")
        and productos_v[0]["anuncios"] == 2
        and sim_v.get("sin_cobertura_d7") == 1
        and dinero(sim_v.get("gasto_evitado"), "1050")
        and dinero(sim_v.get("ventas_perdidas"), "900")
        and sim_v.get("primer_dato") == semilla["primer_dato"]
    )
    st_o, sim_o = simula("platform=amazon_mx&clics=200&gasto=500", "06-simula-otros.json")
    checks["simula_otros_limites"] = (
        st_o == 200
        and sim_o.get("limites", {}).get("clics_min") == 200
        and sim_o.get("productos") == []
        and sim_o.get("sin_cobertura_d7") == 1
        and dinero(sim_o.get("gasto_evitado"), "0")
    )
    st_c, sim_c = simula("platform=amazon_mx&clics=5&gasto=500", "07-simula-422-clics.json")
    st_g, sim_g = simula("platform=amazon_mx&clics=100&gasto=10", "08-simula-422-gasto.json")
    checks["simula_422_con_minimo"] = (
        st_c == 422
        and "al menos 20" in str(sim_c.get("detail"))
        and st_g == 422
        and "al menos 130 MXN" in str(sim_g.get("detail"))
    )
    stj2, _, rawj2 = _http(f"{base}/api/dashboard/productos-sin-clics?plataforma=amazon_mx")
    (evidence / "09-productos-mx-despues.json").write_bytes(rawj2)
    despues = (
        json.loads(rawj2.decode("utf-8")).get("decisiones_producto", {}) if stj2 == 200 else {}
    )
    checks["simular_no_guarda"] = despues.get("limites_pausa") == limites_antes
    return checks


def _encender_pausa(base: str, dsn: str, evidence: Path, semilla: dict) -> dict:
    """productos-encender (AUTO-03 I.8), en la base desechable. La semilla no
    trae las claves de limites: "Encender la pausa" sale deshabilitado con
    "Guarda tus límites primero". Luego la pausa queda en practica como en
    produccion (`productos_modo.cambia_pausa`, el camino de `productos-modo
    --pausa shadow`) y los limites se guardan con `config_write.guarda_config`,
    el escritor al que despacha POST /settings (la instancia de verificacion
    no tiene token ni DSN admin). Con limites, el boton se habilita; encender
    pide la simulacion con los limites guardados (la misma ruta sin clics ni
    gasto) y cancelar no escribe: la config_version y la cola siguen iguales.
    Al final, en vivo la tarjeta dice "En vivo" con "Volver a práctica", y
    de vuelta en practica, "Práctica"."""
    import psycopg

    if str(REPO_ROOT) not in sys.path:
        sys.path.insert(0, str(REPO_ROOT))
    from app import config_write, productos_modo
    from app.optimizer import productos as p

    checks: dict[str, bool] = {}
    mx = "amazon_mx"

    def pagina(nombre: str) -> str:
        st, html = _get_html(base, f"/productos-sin-clics?plataforma={mx}")
        (evidence / nombre).write_bytes(html)
        texto = html.decode("utf-8", errors="replace") if st == 200 else ""
        return _tramo(
            _tramo(texto, 'id="productos-limites"', 'id="productos-retiro"'),
            'id="pausa-vivo"',
            'id="pausa-vivo-estado"',
        )

    def estado(nombre: str) -> dict:
        st, _, raw = _http(f"{base}/api/dashboard/productos/pausa?platform={mx}")
        (evidence / nombre).write_bytes(raw)
        return json.loads(raw.decode("utf-8")) if st == 200 else {}

    def deshabilitado(tramo: str) -> bool:
        return (
            '<button type="button" id="pausa-encender" disabled' in tramo
            and 'aria-describedby="pausa-encender-falta"' in tramo
            and ">Encender la pausa</button>" in tramo
            and "Guarda tus límites primero" in tramo
        )

    def conteos(conn) -> tuple[int, int, int]:
        return conn.execute(
            "SELECT (SELECT count(*) FROM config_version), (SELECT max(id) FROM config_version),"
            " (SELECT count(*) FROM apply_queue)"
        ).fetchone()

    ahora = datetime.now(UTC)
    sin = pagina("10-encender-sin-limites.html")
    e0 = estado("11-pausa-sin-limites.json")
    checks["encender_deshabilitado_sin_limites"] = (
        deshabilitado(sin)
        and f'data-config-id="{semilla["config_version_id"]}"' in sin
        and 'data-modo-vigente="off">Apagada</span>' in sin
        and e0.get("limites_guardados") is False
        and e0.get("modo") == "off"
        and e0.get("config_version_id") == semilla["config_version_id"]
    )

    with psycopg.connect(dsn) as conn:
        practica = productos_modo.cambia_pausa(
            conn, mx, "shadow", semilla["config_version_id"], ahora, actor="orbit-verify"
        )
    en_practica = pagina("12-encender-practica-sin-limites.html")
    e1 = estado("13-pausa-practica-sin-limites.json")
    checks["encender_practica_sigue_deshabilitado"] = (
        deshabilitado(en_practica)
        and 'data-modo-vigente="shadow">Práctica</span>' in en_practica
        and e1.get("modo") == "shadow"
        and e1.get("limites_guardados") is False
        and e1.get("config_version_id") == practica["config_version_id"]
    )

    with psycopg.connect(dsn) as conn:
        guardado = config_write.guarda_config(
            conn,
            platform=mx,
            base_config_version_id=practica["config_version_id"],
            ahora=ahora,
            actor="orbit-verify",
            limites_pausa=p.LimitesPausa(100, p.Dinero(Decimal("500"), "MXN")),
        )
        antes = conteos(conn)
    config_limites = guardado["config_version_id"]
    con = pagina("14-encender-con-limites.html")
    e2 = estado("15-pausa-con-limites.json")
    checks["encender_habilitado_con_limites"] = (
        '<button type="button" id="pausa-encender">Encender la pausa</button>' in con
        and "Guarda tus límites primero" not in con
        and f'data-config-id="{config_limites}"' in con
        and 'type="password" id="pausa-token"' in con
        and ">Confirmar</button>" in con
        and ">Cancelar</button>" in con
        and e2
        == {
            "platform": mx,
            "modo": "shadow",
            "modo_texto": "Práctica",
            "config_version_id": config_limites,
            "limites": {"clics": 100, "gasto": {"valor": "500", "moneda": "MXN"}},
            "limites_guardados": True,
            "error": None,
        }
    )

    # "Encender la pausa" pide la simulacion con los limites guardados.
    st_s, _, raw_s = _http(f"{base}/api/dashboard/productos/simula-pausa?platform={mx}", timeout=15)
    (evidence / "16-encender-simulacion.json").write_bytes(raw_s)
