        _die(f"punto de partida GET / fallo: {st0}")

    st_html, html = _get_html(base, "/inertes")
    (evidence / "02-inertes.html").write_bytes(html)
    texto = html.decode("utf-8", errors="replace")

    checks: dict[str, bool] = {
        "http_200": st_html == 200,
        "data-pantalla=inertes": 'data-pantalla="inertes"' in texto,
        "h2_inertes": "<h2>Entidades sin trafico</h2>" in texto,
        "nav_aria_current": 'href="/inertes"' in texto and 'aria-current="page"' in texto,
        "vacio_semilla": "sin entidades inertes: todo lo activo tiene trafico reciente." in texto,
    }

    stj, _, rawj = _http(f"{base}/api/dashboard/inertes")
    (evidence / "03-inertes.json").write_bytes(rawj)
    data = {}
    if stj == 200:
        data = json.loads(rawj.decode("utf-8"))
    checks["api_http_200"] = stj == 200
    checks["api_items_vacios"] = data.get("items") == []
    checks["api_totales_vacios"] = data.get("totales") == {}

    prueba = {
        "feature": "inertes",
        "entry_point": "nav /inertes",
        "base_url": base,
        "action": "GET /inertes y GET /api/dashboard/inertes",
        "checks": checks,
        "ok": all(checks.values()),
        "evidence_dir": str(evidence),
    }
    (evidence / "PROOF.json").write_text(json.dumps(prueba, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(prueba, indent=2))
    if not prueba["ok"]:
        fallaron = [k for k, v in checks.items() if not v]
        _die("drive-inertes FALLA: " + ", ".join(fallaron))


def cmd_drive_maintain_verification_skill(args: argparse.Namespace) -> None:
    run_id = args.run_id or _run_id()
    port = args.port

    launch_args = argparse.Namespace(run_id=run_id, port=port, force=args.force)

    try:
        cmd_launch(launch_args)
        doctor_args = argparse.Namespace(run_id=run_id)
        cmd_doctor(doctor_args)

        drive_args = argparse.Namespace(run_id=run_id)
        for drive in (
            cmd_drive_resumen,
            cmd_drive_campanas,
            cmd_drive_decisiones,
            cmd_drive_salud,
            cmd_drive_contribucion,
            cmd_drive_cortes,
            cmd_drive_inertes,
        ):
            try:
                drive(drive_args)
            except SystemExit:
                with contextlib.suppress(SystemExit):
                    cmd_doctor(doctor_args)
                raise

    finally:
        if _state_path(run_id).is_file():
            cmd_cleanup(argparse.Namespace(run_id=run_id))

    out = {
        "ok": True,
        "run_id": run_id,
        "evidence_root": str(_evidence_dir(run_id)),
        "scratch_dir": str(_scratch(run_id)),
    }
    print(json.dumps(out, indent=2))


def cmd_cleanup(args: argparse.Namespace) -> None:
    run_id = args.run_id or _latest_run_id()
    ruta = _state_path(run_id)
    if not ruta.is_file():
        print(f"orbit-verify: nada que limpiar para {run_id}")
        return
    state = json.loads(ruta.read_text(encoding="utf-8"))
    pid = int(state["pid"])
    _cleanup_proceso(pid)
    import psycopg
    from psycopg import sql as pgsql

    db_dropeada = True
    try:
        admin = psycopg.connect(ADMIN_DSN, autocommit=True)
        admin.execute(
            pgsql.SQL("DROP DATABASE IF EXISTS {} WITH (FORCE)").format(
                pgsql.Identifier(state["db"])
            )
        )
        admin.close()
    except Exception as exc:  # noqa: BLE001 — cleanup best-effort de la DB
        db_dropeada = False
        print(f"orbit-verify: aviso al dropear {state['db']}: {exc}", file=sys.stderr)

    scratch = Path(state.get("scratch_dir") or _scratch(run_id))
    if db_dropeada and scratch.is_dir():
        shutil.rmtree(scratch, ignore_errors=True)
    elif not db_dropeada:
        print(
            f"orbit-verify: conservo {scratch} para reintentar el drop de {state['db']}",
            file=sys.stderr,
        )

    evidencia = Path(state["evidence_dir"])
    if not evidencia.is_dir():
        _die(f"cleanup termino pero la evidencia desaparecio: {evidencia}")
    print(
        json.dumps(
            {
                "cleaned_run_id": run_id,
                "killed_pid": pid,
                "dropped_db": state["db"] if db_dropeada else None,
                "evidence_still_at": str(evidencia),
            }
        )
    )


def main() -> None:
    parser = argparse.ArgumentParser(description="Verificacion local de Orbit")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_launch = sub.add_parser("launch", help="Levanta instancia local desechable")
    p_launch.add_argument("--run-id", default=None)
    p_launch.add_argument("--port", type=int, default=DEFAULT_PORT)
    p_launch.add_argument("--force", action="store_true")
    p_launch.set_defaults(func=cmd_launch)

    p_doc = sub.add_parser("doctor", help="Chequeo de solo lectura")
    p_doc.add_argument("--run-id", default=None)
    p_doc.set_defaults(func=cmd_doctor)

    p_drive_resumen = sub.add_parser("drive-resumen", help="Conduce la pantalla Resumen")
    p_drive_resumen.add_argument("--run-id", default=None)
    p_drive_resumen.set_defaults(func=cmd_drive_resumen)

    p_drive_decisiones = sub.add_parser("drive-decisiones", help="Conduce la pantalla Decisiones")
    p_drive_decisiones.add_argument("--run-id", default=None)
    p_drive_decisiones.set_defaults(func=cmd_drive_decisiones)

    p_drive_salud = sub.add_parser("drive-salud", help="Conduce la pantalla Salud")
    p_drive_salud.add_argument("--run-id", default=None)
    p_drive_salud.set_defaults(func=cmd_drive_salud)

    p_drive_contribucion = sub.add_parser(
        "drive-contribucion",
        help="Conduce la pantalla Contribucion",
    )
    p_drive_contribucion.add_argument("--run-id", default=None)
    p_drive_contribucion.set_defaults(func=cmd_drive_contribucion)

    p_drive_cortes = sub.add_parser("drive-cortes", help="Conduce la pantalla Cortes")
    p_drive_cortes.add_argument("--run-id", default=None)
    p_drive_cortes.set_defaults(func=cmd_drive_cortes)

    p_drive_inertes = sub.add_parser("drive-inertes", help="Conduce la pantalla Inertes")
    p_drive_inertes.add_argument("--run-id", default=None)
    p_drive_inertes.set_defaults(func=cmd_drive_inertes)

    p_drive = sub.add_parser("drive-campanas", help="Conduce la pantalla Campanas")
    p_drive.add_argument("--run-id", default=None)
    p_drive.set_defaults(func=cmd_drive_campanas)

    p_maint = sub.add_parser(
        "maintain-verification-skill",
        help="Orquesta launch + doctor + drives y hace teardown al final",
    )
    p_maint.add_argument("--run-id", default=None)
    p_maint.add_argument("--port", type=int, default=DEFAULT_PORT)
    p_maint.add_argument("--force", action="store_true")
    p_maint.set_defaults(func=cmd_drive_maintain_verification_skill)

    p_clean = sub.add_parser("cleanup", help="Tira la instancia de este run")
    p_clean.add_argument("--run-id", default=None)
    p_clean.set_defaults(func=cmd_cleanup)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
