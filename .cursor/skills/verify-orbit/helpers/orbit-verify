        (ciclo_live_id, hoja_id, decided_at),
    )
    # Un solo ciclo con notes: /salud toma DISTINCT ON (platform) ORDER BY
    # id DESC (este shadow, id mayor). Un segundo ciclo sin notes escondia
    # los skips del snapshot.
    ciclo_id = conn.execute(
        "INSERT INTO optimizer_cycle (motor, mode, platform, status, finished_at,"
        " decisions_count, applied_count, notes) VALUES"
        " ('ads_optimizer', 'shadow', 'amazon_us', 'done', %s, 2, 0, %s) RETURNING id",
        (
            decided_at,
            '{"skips": {"entidad": {"estado_no_enabled": 3}},'
            ' "decisiones": {"bid": 1, "negative": 1}}',
        ),
    ).fetchone()[0]
    bid_id = conn.execute(
        "INSERT INTO decision (cycle_id, ad_entity_id, kind, decided_at, config_version_id,"
        " data_observed_at, window_start, window_end, old_value, new_value, value_currency,"
        " inputs) VALUES (%s, %s, 'bid', %s, %s, %s, %s, %s, 1.00, 0.88, 'USD', %s)"
