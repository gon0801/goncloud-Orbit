#!/usr/bin/env python3
"""Andamiaje de verificacion de Orbit (no es codigo de producto).

Subcomandos:
  launch          Postgres desechable + migraciones + semilla + uvicorn local
  doctor          Chequeo de solo lectura: proceso, puerto, build, DSN
  drive-resumen   Receta curl de la pantalla Resumen + evidencia (canvas y JSON)
  drive-decisiones Receta curl de la pantalla Decisiones + evidencia (HTML y JSON)
  drive-salud     Receta curl de la pantalla Salud + evidencia (canvas, HTML y JSON)
  drive-contribucion Receta curl de la pantalla Contribucion + evidencia (HTML y JSON)
  drive-cortes    Receta curl de la pantalla Cortes + evidencia (HTML y JSON)
  drive-inertes   Receta curl de la pantalla Inertes + evidencia (HTML y JSON)
  drive-campanas  Receta curl de la pantalla Campanas + captura de evidencia
  maintain-verification-skill
                 Orquesta launch + doctor + drives y hace teardown al final
  cleanup         Tira SOLO la instancia de este run_id; no borra evidencia

Estado scratch: /tmp/orbit-verify/<run_id>/
Evidencia:      .cursor/skills/verify-orbit/evidence/<run_id>/
"""

