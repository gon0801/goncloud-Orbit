    pausa = _sembrar_pausa(conn, entidad, ahora, hoja)

    ventana_halo = p.Ventana(hoy - timedelta(days=90), hoy - timedelta(days=3))

    def entrada(producto: int, margen_pct: str, dias_halo, grupos) -> p.EntradaProducto:
        return p.EntradaProducto(
            producto=p.Producto("amazon_mx", producto),
            decidido_el=ahora,
            margen=g.MedicionMargen(
                Decimal(margen_pct),
                Decimal("0.99"),
                45,
                Decimal("12000"),
                ahora,
                "MXN",
                hoy - timedelta(days=45),
                hoy - timedelta(days=15),
            ),
            fraccion=Decimal("0.5"),
            ventana_halo=ventana_halo,
            dias_halo=dias_halo,
            actividad_pausa=p.SinDato(("sin_filas_en_ventana",)),
            anuncios=(),
            grupos_aptos_para_meta=grupos,
            impedimentos=(),
            limites_pausa=p.limites_pausa_desde_settings({}, "amazon_mx"),
        )

    def mxn(valor: str) -> p.Dinero:
        return p.Dinero(Decimal(valor), "MXN")

    evaluaciones = [
        p.resolver_producto(
            entrada(
                collar,
                "8",
                (),
                (
                    p.GrupoAptoParaMeta(
                        grupo_id=grupo,
                        campana_id=camp,
                        hojas=(hoja,),
                        ventana_evidencia_hojas=ventana_halo,
                        referencias_identidad_y_halo=(),
                        huella_alcance="sha256:verify-orbit",
                    ),
                ),
            )
        ),
        p.resolver_producto(
            entrada(
                aretes,
                "30",
                (
                    p.DiaProducto(
                        hoy - timedelta(days=40), mxn("80"), 12, Decimal(2), mxn("500"), mxn("200")
                    ),
                ),
                (),
            )
        ),
    ]
